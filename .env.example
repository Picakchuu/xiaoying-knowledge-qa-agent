# 默认 mock 模式无需任何变量；只有 --model real 才需要下面几项。
# 复制为 .env 后填写（.env 已被 .gitignore 排除，切勿提交）。

# 模型名：填服务端真正接受的那个 id（例如 deepseek-chat、deepseek-v4-pro、qwen-plus…）
# 换模型只改这几行，代码不用动。
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
MODEL_TEMPERATURE=0.1
MODEL_TIMEOUT=60

# 推理型模型（会把 token 花在 reasoning_tokens 上）建议给足预算，
# 否则会出现「返回空内容」；实测 deepseek-v4-pro 用 3000 足够。
MODEL_MAX_TOKENS=3000
